{
  "name": "malhars-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Malhar's Library: a bookshelf site that rebuilds itself from Goodreads and the Mr Philomath favourites post",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs --no-watch",
    "check": "node scripts/check-site.mjs site",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "colorthief": "3.5.0",
    "fast-xml-parser": "5.11.2",
    "sharp": "0.35.5"
  }
}
